#
# rules.nft — prod overlay: block outbound traffic to RFC-reserved destinations
#
# Applied atomically on every pod start — idempotent.
# The table (inet nft-custom) is deleted and recreated from this file each time.
#
# Policy: allow all traffic by default; explicitly drop packets destined for
# bogon (RFC-reserved, private, unroutable) addresses before they leave the node.
#
# Sources:
#   IANA Special-Purpose Address Registry (IPv4 / IPv6)
#   https://www.iana.org/assignments/iana-ipv4-special-registry
#   https://www.iana.org/assignments/iana-ipv6-special-registry
#

table inet k8s_pod_nfs_guard {
  set pod_sources {
    type ipv4_addr
    flags interval
    elements = { 10.246.0.0/16 }
  }
  set nfs_servers {
    type ipv4_addr
    elements = { 192.168.0.0/24 }
  }
  chain block_pod_to_nfs {
    type filter hook forward priority -150; policy accept;
    ip saddr @pod_sources ip daddr @nfs_servers tcp dport 2049 counter reject with tcp reset
    ip saddr @pod_sources ip daddr @nfs_servers udp dport 2049 counter reject
  }
}
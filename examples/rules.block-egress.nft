#
# rules.block-egress.nft — example: block outbound traffic to bogon destinations
#
# Drop-in replacement for the rules.nft key in the nft-config ConfigMap.
# All RFC-reserved, private, and unroutable address ranges are dropped before
# any traffic leaves the node or is forwarded from pods.
#
# Sources:
#   IANA Special-Purpose Address Registry (IPv4 / IPv6)
#   https://www.iana.org/assignments/iana-ipv4-special-registry
#   https://www.iana.org/assignments/iana-ipv6-special-registry
#

table inet nft-custom {

    # ══════════════════════════════════════════════════════════════════════════
    # Named sets
    # ══════════════════════════════════════════════════════════════════════════

    # ── IPv4 bogon destinations ───────────────────────────────────────────────
    set bogon4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,           # "This" network (RFC 1122 §3.2.1.3)
            10.0.0.0/8,          # Private-use (RFC 1918)
            100.64.0.0/10,       # Shared address / CGNAT (RFC 6598)
            127.0.0.0/8,         # Loopback (RFC 1122 §3.2.1.3)
            169.254.0.0/16,      # Link-local / APIPA (RFC 3927)
            172.16.0.0/12,       # Private-use (RFC 1918)
            192.0.0.0/24,        # IETF protocol assignments (RFC 6890)
            192.0.2.0/24,        # TEST-NET-1 / documentation (RFC 5737)
            192.88.99.0/24,      # 6to4 relay anycast — deprecated (RFC 7526)
            192.168.0.0/16,      # Private-use (RFC 1918)
            198.18.0.0/15,       # Benchmarking (RFC 2544)
            198.51.100.0/24,     # TEST-NET-2 / documentation (RFC 5737)
            203.0.113.0/24,      # TEST-NET-3 / documentation (RFC 5737)
            224.0.0.0/4,         # Multicast (RFC 3171)
            240.0.0.0/4,         # Reserved / future use (RFC 1112)
            255.255.255.255/32   # Limited broadcast
        }
    }

    # ── IPv6 bogon destinations ───────────────────────────────────────────────
    set bogon6 {
        type ipv6_addr
        flags interval
        elements = {
            ::/128,              # Unspecified address (RFC 4291)
            ::1/128,             # Loopback (RFC 4291)
            ::ffff:0:0/96,       # IPv4-mapped (RFC 4291)
            64:ff9b::/96,        # IPv4/IPv6 translation (RFC 6052)
            64:ff9b:1::/48,      # IPv4/IPv6 translation (RFC 8215)
            100::/64,            # Discard prefix (RFC 6666)
            2001::/23,           # IETF protocol assignments (RFC 2928)
            2001:2::/48,         # Benchmarking (RFC 5180)
            2001:db8::/32,       # Documentation (RFC 3849)
            2001:10::/28,        # ORCHID v1 — deprecated (RFC 4843)
            2002::/16,           # 6to4 (RFC 3056)
            fc00::/7,            # Unique local / ULA (RFC 4193)
            fe80::/10,           # Link-local (RFC 4291)
            fec0::/10,           # Site-local — deprecated (RFC 3879)
            ff00::/8             # Multicast (RFC 4291)
        }
    }

    # ── Custom destination blocklist (optional) ───────────────────────────────
    # Add site-specific IP ranges to block here.
    # set custom_block4 {
    #     type ipv4_addr
    #     flags interval
    #     elements = {
    #         203.0.113.100/32,   # example: block a specific host
    #     }
    # }

    # ══════════════════════════════════════════════════════════════════════════
    # Chains
    # ══════════════════════════════════════════════════════════════════════════

    # ── Outbound traffic from this node ───────────────────────────────────────
    chain output {
        type filter hook output priority filter;
        policy accept;

        # Drop packets whose destination is a bogon address.
        ip  daddr @bogon4 drop comment "block IPv4 bogon destinations"
        ip6 daddr @bogon6 drop comment "block IPv6 bogon destinations"

        # ip daddr @custom_block4 drop comment "block custom destinations"
    }

    # ── Forwarded traffic (pods → external) ───────────────────────────────────
    chain forward {
        type filter hook forward priority filter;
        policy accept;

        ip  daddr @bogon4 drop comment "block IPv4 bogon destinations from pods"
        ip6 daddr @bogon6 drop comment "block IPv6 bogon destinations from pods"

        # ip daddr @custom_block4 drop comment "block custom destinations from pods"
    }
}
